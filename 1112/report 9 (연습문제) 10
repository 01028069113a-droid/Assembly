10. 문자 행렬 (Letter Matrix)

무작위로 선택된 대문자로 이루어진 4x4 행렬을 생성하는 프로시저를 작성하시오. 문자를 선택할 때, 선택된 문자가 모음(vowel)일 확률이 50%여야 
한다. 프로시저를 5번 호출하고 각 행렬을 콘솔 창에 출력하는 루프가 포함된 테스트 프로그램을 작성하시오. 다음은 첫 세 개의 행렬에 대한 샘플 
출력이다.

정답:

INCLUDE Irvine32.inc

GenerateMatrix PROTO
PrintMatrix PROTO

.data
matrix BYTE 16 DUP(0)

.code
main PROC
    call Randomize              ; 난수 생성기 시드 초기화

    mov ecx, 5                  ; 5번 반복하여 행렬 생성 및 출력
test_loop:
    call GenerateMatrix
    call PrintMatrix
    call Crlf                   ; 행렬 간 빈 줄 출력
    loop test_loop

    exit
main ENDP

;-----------------------------------------------------------
GenerateMatrix PROC USES eax ecx edi
; 50% 확률로 모음(A, E, I, O, U) 또는 자음을 선택하여 4x4 바이트 배열을 채움
;-----------------------------------------------------------
    mov edi, OFFSET matrix
    mov ecx, 16                 ; 4x4 = 총 16개 문자

gen_loop:
    ; 50% 확률 결정 (0 또는 1 생성)
    mov eax, 2
    call RandomRange
    cmp eax, 0
    je pick_vowel               ; 0이면 모음 선택

    ; 자음 선택 (A, E, I, O, U를 제외한 무작위 대문자)
pick_consonant:
    mov eax, 26
    call RandomRange
    add eax, 'A'
    cmp al, 'A'
    je pick_consonant
    cmp al, 'E'
    je pick_consonant
    cmp al, 'I'
    je pick_consonant
    cmp al, 'O'
    je pick_consonant
    cmp al, 'U'
    je pick_consonant
    jmp store_char

    ; 모음 선택 (A, E, I, O, U 중 하나)
pick_vowel:
    mov eax, 5
    call RandomRange
    cmp eax, 0
    je vowel_A
    cmp eax, 1
    je vowel_E
    cmp eax, 2
    je vowel_I
    cmp eax, 3
    je vowel_O
    mov al, 'U'
    jmp store_char

vowel_A: 
    mov al, 'A' 
    jmp store_char
vowel_E: 
    mov al, 'E' 
    jmp store_char
vowel_I: 
    mov al, 'I' 
    jmp store_char
vowel_O: 
    mov al, 'O' 
    jmp store_char

store_char:
    mov [edi], al               ; 선택된 문자를 배열에 저장
    inc edi
    loop gen_loop

    ret
GenerateMatrix ENDP

;-----------------------------------------------------------
PrintMatrix PROC USES eax ecx esi
; 4x4 행렬을 콘솔 창에 4행 4열 형태로 출력
;-----------------------------------------------------------
    mov esi, OFFSET matrix
    mov ecx, 4                  ; 4개 행

row_loop:
    push ecx
    mov ecx, 4                  ; 행당 4개 열
col_loop:
    mov al, [esi]
    call WriteChar              ; 문자 출력
    mov al, ' '
    call WriteChar              ; 가로 간격 공백 출력
    inc esi
    loop col_loop

    call Crlf                   ; 줄 바꿈
    pop ecx
    loop row_loop

    ret
PrintMatrix ENDP
END main
