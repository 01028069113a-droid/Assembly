6. 빈도수 테이블 생성 (Constructing a Frequency Table)
문자 빈도수 테이블을 구성하는 Get_frequencies라는 프로시저를 작성하시오. 프로시저의 입력은 문자열 포인터와 모두 0으로 초기화된 256개의 
더블워드(doubleword) 배열 포인터여야 한다. 배열의 각 위치는 해당하는 ASCII 코드로 인덱싱된다. 프로시저가 반환될 때 배열의 각 항목에는 해당 
문자가 문자열에 몇 번 나타났는지에 대한 횟수가 저장되어야 한다. 예를 들면 다음과 같다:

정답:
INCLUDE Irvine32.inc

Get_frequencies PROTO,
    pString:PTR BYTE,
    pTable:PTR DWORD

.data
target BYTE "AAEBDCFBBC", 0
freqTable DWORD 256 DUP(0)

.code
main PROC
    INVOKE Get_frequencies, ADDR target, ADDR freqTable

    ; 결과 확인용 출력 (대문자 A부터 Z까지의 빈도수 출력)
    mov ecx, 26
    mov esi, 'A'                ; 'A'(65)부터 시작
print_loop:
    mov eax, esi
    call WriteChar
    mov al, ':'
    call WriteChar
    mov eax, freqTable[esi * TYPE DWORD]
    call WriteDec
    mov al, ' '
    call WriteChar
    inc esi
    loop print_loop
    call Crlf
    exit
main ENDP

;-----------------------------------------------------------
Get_frequencies PROC USES eax esi edi,
    pString:PTR BYTE,
    pTable:PTR DWORD
; 문자열을 순회하며 각 문자의 ASCII 코드를 인덱스로 하여
; freqTable의 해당 요소 값을 1씩 증가시킴
;-----------------------------------------------------------
    mov esi, pString
    mov edi, pTable
    mov eax, 0                  ; 인덱스 연산을 위해 상위 바이트 클리어

L1:
    mov al, [esi]               ; 문자열에서 1바이트 문자를 로드
    cmp al, 0                   ; 문자열 끝(NULL 바이트)인지 확인
    je done
    inc DWORD PTR [edi + eax * 4] ; freqTable[ASCII] += 1 (더블워드 크기 4바이트)
    inc esi
    jmp L1

done:
    ret
Get_frequencies ENDP
END main
