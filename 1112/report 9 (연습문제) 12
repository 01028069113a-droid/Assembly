12. Calculating the Sum of an Array Row (배열 행의 합계 계산)

바이트, 워드, 또는 더블워드로 이루어진 2차원 배열의 특정 행 합계를 계산하는 calc_row_sum 프로시저를 작성하시오. 
이 프로시저는 스택 매개변수로 배열 오프셋(array offset), 행 크기(row size - 열의 개수), 배열 타입(array type - 1, 2, 또는 4바이트), 
행 인덱스(row index)를 가져야 한다. 합계는 EAX에 반환되어야 한다. INVOKE나 확장된 PROC 대신 명시적인 스택 매개변수를 사용하시오. 바이트, 워드, 
더블워드 배열을 사용하여 프로시저를 테스트하는 프로그램을 작성하고, 사용자에게 행 인덱스를 입력받아 선택한 행의 합계를 출력하시오.


정답:

INCLUDE Irvine32.inc

.data
prompt  BYTE "Enter row index (0-2): ", 0
sumMsg  BYTE "Row sum = ", 0

; 3행 4열 더블워드 2차원 배열 예시
arrayD  DWORD 1, 2, 3, 4
        DWORD 5, 6, 7, 8
        DWORD 9, 10, 11, 12
rowSize DWORD 4
typeD   DWORD 4

.code
main PROC
    call Clrscr
    mov edx, OFFSET prompt
    call WriteString
    call ReadInt            ; EAX에 행 인덱스 입력됨
    push eax                ; row index

    push typeD              ; array type (4)
    push rowSize            ; row size (4)
    push OFFSET arrayD      ; array offset

    call calc_row_sum

    ; 결과 출력
    mov edx, OFFSET sumMsg
    call WriteString
    call WriteDec
    call Crlf

    exit
main ENDP

;-----------------------------------------------------------
calc_row_sum PROC
; 스택 구조: [ebp+8]=offset, [ebp+12]=rowSize, [ebp+16]=type, [ebp+20]=rowIndex
;-----------------------------------------------------------
    push ebp
    mov ebp, esp
    push ebx
    push ecx
    push esi
    push edi

    ; 시작 주소 계산: offset + (rowIndex * rowSize * type)
    mov eax, [ebp + 20]     ; row index
    imul eax, [ebp + 12]    ; * row size
    imul eax, [ebp + 16]    ; * array type
    mov esi, [ebp + 8]      ; array offset
    add esi, eax            ; ESI = 선택된 행의 시작 주소

    mov ecx, [ebp + 12]     ; 루프 카운터 = row size (열 개수)
    xor eax, eax            ; 누적 합계 초기화 (EAX)
    mov edx, [ebp + 16]     ; 배열 타입 (1, 2, 또는 4)

sum_loop:
    cmp edx, 1
    je is_byte
    cmp edx, 2
    je is_word
    ; doubleword인 경우
    mov ebx, [esi]
    add eax, ebx
    add esi, 4
    jmp next_element

is_byte:
    movzx ebx, byte ptr [esi]
    add eax, ebx
    inc esi
    jmp next_element

is_word:
    movzx ebx, word ptr [esi]
    add eax, ebx
    add esi, 2

next_element:
    loop sum_loop

    pop edi
    pop esi
    pop ecx
    pop ebx
    pop ebp
    ret 16                  ; 4개의 매개변수(16바이트) 정리 후 복귀
calc_row_sum ENDP
END main
