13. Trimming Leading Characters (선행 문자 제거)

문자열의 시작 부분(선행)에 있는 특정 문자의 모든 인스턴스를 호출자가 제거할 수 있도록 Str_trim 프로시저의 변형 버전을 만드시오. 
예를 들어, "###ABC" 문자열에 대한 포인터와 # 문자를 전달하여 호출한다면, 결과 문자열은 "ABC"가 되어야 한다.

정답:
INCLUDE Irvine32.inc

Str_trimLead PROTO,
    pString:PTR BYTE,
    charToTrim:BYTE

.data
testStr BYTE "###ABC", 0

.code
main PROC
    INVOKE Str_trimLead, ADDR testStr, '#'
    mov edx, OFFSET testStr
    call WriteString        ; 출력 결과: ABC
    call Crlf
    exit
main ENDP

;-----------------------------------------------------------
Str_trimLead PROC USES eax esi edi,
    pString:PTR BYTE,
    charToTrim:BYTE
; 문자열 앞부분의 연속된 charToTrim 문자를 제거하고 앞으로 당김
;-----------------------------------------------------------
    mov esi, pString
    mov al, charToTrim

; 1. 연속된 대상 문자를 건너뜀
find_first_non_match:
    cmp byte ptr [esi], 0
    je done
    cmp [esi], al
    jne copy_remaining
    inc esi
    jmp find_first_non_match

; 2. 남은 문자들을 앞으로 당김
copy_remaining:
    mov edi, pString
mov_loop:
    mov al, [esi]
    mov [edi], al
    inc esi
    inc edi
    cmp al, 0
    jne mov_loop

done:
    ret
Str_trimLead ENDP
END main
