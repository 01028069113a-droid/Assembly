2. 특정 범위 내 배열 요소의 합 구하기 (Summing Array Elements in a Range)

문제:
$j \dots k$ 범위(양 끝 값 포함)에 속하는 모든 배열 요소의 합을 반환하는 프로시저를 작성하세요. 
부호 있는 더블워드(signed doubleword) 배열의 포인터, 배열의 크기, 그리고 $j$와 $k$ 값을 전달하며 프로시저를 두 번 호출하는 테스트 프로그램을 작성하세요.
합계는 EAX 레지스터에 반환하고, 프로시저 호출 간에 다른 모든 레지스터 값은 보존해야 합니다. 

정답: 
INCLUDE Irvine32.inc

.data
array SDWORD 10, -5, 25, 30, 0, -15, 50, 8, 12, 40
ARRAY_SIZE = LENGTHOF array

.code
main PROC
    ; 첫 번째 호출: 범위 [0, 30]
    mov esi, OFFSET array   ; 배열 포인터
    mov ecx, ARRAY_SIZE     ; 배열 크기
    mov ebx, 0              ; j
    mov edx, 30             ; k
    call SumRange           ; EAX에 결과 반환
    call WriteInt           ; 결과 출력
    call Crlf

    ; 두 번째 호출: 범위 [-20, 10]
    mov esi, OFFSET array
    mov ecx, ARRAY_SIZE
    mov ebx, -20            ; j
    mov edx, 10             ; k
    call SumRange           ; EAX에 결과 반환
    call WriteInt           ; 결과 출력
    call Crlf

    exit
main ENDP

;------------------------------------------------------------
; SumRange
; 전달인자: ESI = 배열 포인터, ECX = 크기, EBX = j, EDX = k
; 반환: EAX = [j, k] 범위 요소들의 합
;------------------------------------------------------------
SumRange PROC
    push ebx
    push ecx
    push edx
    push esi
    push edi                ; 누적 합을 보관할 레지스터

    mov edi, 0              ; 누적합 초기화

L1:
    mov eax, [esi]          ; 배열 요소 읽기
    ; [j, k] 범위 체크 (j <= eax <= k)
    cmp eax, ebx            ; eax >= j 확인
    jl Next
    cmp eax, edx            ; eax <= k 확인
    jg Next

    add edi, eax            ; 범위 내에 있으면 합산

Next:
    add esi, 4              ; 다음 요소
    loop L1

    mov eax, edi            ; 결과를 EAX에 저장
    pop edi
    pop esi
    pop edx
    pop ecx
    pop ebx
    ret
SumRange ENDP

END main
