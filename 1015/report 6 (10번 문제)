10. 패리티 검사 (Parity Checking)📌 번역데이터 전송 시스템과 파일 서브시스템은 종종 데이터 블록의 패리티(짝수 또는 홀수) 계산에 의존하는 오류 검출 방식을 사용합니다.  
 여러분의 임무는 배열 내의 바이트들이 짝수 패리티(even parity)를 포함하면 EAX 레지스터에 참(True)을 반환하고, 홀수 패리티(odd parity)이면 거짓(False)을 반환하는 프로시저를 만드는 것입니다.  
 즉, 전체 배열의 모든 비트를 셀 때 그 개수가 짝수인지 홀수인지 판별하는 것입니다. 
  프로시저 호출 간에 다른 모든 레지스터 값은 보존해야 합니다.   
프로시저에 배열의 포인터와 배열의 길이를 전달하여 두 번 호출하는 테스트 프로그램을 작성하세요.   
EAX의 반환 값은 1(True) 또는 0(False)이어야 합니다.   
테스트 데이터로는 적어도 10바이트를 포함하는 두 개의 배열을 만들고, 하나는 짝수 패리티를, 다른 하나는 홀수 패리티를 가지도록 하세요.   
팁: 이 장의 앞부분에서 바이트 값 시퀀스에 XOR 명령어를 반복적으로 적용하여 패리티를 결정하는 방법을 보여주었습니다.
 따라서 이는 루프의 사용을 암시합니다. 
하지만 일부 기계어 명령어는 패리티 플래그(Parity flag)에 영향을 미치고 일부는 그렇지 않으므로 주의해야 합니다. 
이는 부록 B의 개별 명령어를 보면 확인할 수 있습니다. 
루프 내에서 패리티를 검사하는 코드는 코드에 의해 의도치 않게 수정되는 것을 방지하기 위해 패리티 플래그의 상태를 신중하게 저장하고 복원해야 합니다.

정답:

INCLUDE Irvine32.inc

.data
; 10바이트 이상의 짝수 패리티 배열 (총 비트 개수가 짝수 개)
evenArray   BYTE 10h, 20h, 30h, 40h, 50h, 60h, 70h, 80h, 90h, 00h 
EVEN_LEN    = ($ - evenArray)

; 10바이트 이상의 홀수 패리티 배열 (총 비트 개수가 홀수 개)
oddArray    BYTE 10h, 20h, 30h, 40h, 50h, 60h, 70h, 80h, 90h, 01h 
ODD_LEN     = ($ - oddArray)

msgEven     BYTE "결과: 짝수 패리티 (True / 1)", 0
msgOdd      BYTE "결과: 홀수 패리티 (False / 0)", 0

.code
main PROC
    ; 첫 번째 테스트: 짝수 패리티 배열 전달
    mov esi, OFFSET evenArray
    mov ecx, EVEN_LEN
    call CheckParity
    
    ; 결과 출력
    cmp eax, 1
    jne ShowOdd1
    mov edx, OFFSET msgEven
    call WriteString
    call Crlf
    jmp Test2
ShowOdd1:
    mov edx, OFFSET msgOdd
    call WriteString
    call Crlf

Test2:
    ; 두 번째 테스트: 홀수 패리티 배열 전달
    mov esi, OFFSET oddArray
    mov ecx, ODD_LEN
    call CheckParity

    ; 결과 출력
    cmp eax, 1
    jne ShowOdd2
    mov edx, OFFSET msgEven
    call WriteString
    call Crlf
    jmp EndProgram
ShowOdd2:
    mov edx, OFFSET msgOdd
    call WriteString
    call Crlf

EndProgram:
    exit
main ENDP

;------------------------------------------------------------
; CheckParity
; 전달인자: ESI = 배열 포인터, ECX = 배열 길이 (바이트 수)
; 반환: EAX = 1 (짝수 패리티 / True), 0 (홀수 패리티 / False)
;------------------------------------------------------------
CheckParity PROC
    push esi
    push ecx
    push ebx

    mov al, 0               ; 누적 XOR 값 초기화

L_Loop:
    xor al, [esi]           ; 바이트 값을 순차적으로 XOR 연산
    inc esi
    loop L_Loop

    ; XOR 연산 결과(AL)의 패리티 플래그(PF) 확인
    ; PF는 1인 비트의 총 개수가 짝수이면 1(Even), 홀수이면 0(Odd)으로 설정됨
    mov eax, 0              ; 기본값 False (0) 설정 (mov는 플래그를 변경하지 않음)
    
    jp IsEven               ; 패리티 플래그가 1(짝수)이면 점프
    jmp Done                ; 홀수이면 EAX = 0 유지

IsEven:
    mov eax, 1              ; 짝수이면 EAX = 1 (True)

Done:
    pop ebx
    pop ecx
    pop esi
    ret
CheckParity ENDP

END main
