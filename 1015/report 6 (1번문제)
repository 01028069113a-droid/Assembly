1. 배열 채우기 (Filling an Array)

문제:더블워드(doubleword) 배열을 N개의 난수로 채우는 프로시저(procedure)를 작성하세요. 
이때 값은 j \dots k 범위(양 끝 값 포함)에 속해야 합니다. 프로시저를 호출할 때 데이터를 저장할 배열의 포인터, N, 그리고 j와 k 값을 전달하세요. 
프로시저 호출 간에 모든 레지스터 값을 보존해야 합니다. 서로 다른 j와 k 값을 사용하여 프로시저를 두 번 호출하는 테스트 프로그램을 작성하세요. 
디버거를 사용하여 결과를 확인하세요. 


정답
INCLUDE Irvine32.inc

.data
N = 20
array DWORD N DUP(?)

.code
main PROC
    call Randomize          ; 난수 생성기 초기화

    ; 첫 번째 호출: 범위 [10, 50]
    mov esi, OFFSET array   ; 배열 포인터
    mov ecx, N              ; 개수 N
    mov ebx, 10             ; j (최솟값)
    mov edx, 50             ; k (최댓값)
    call FillArray

    ; 두 번째 호출: 범위 [-20, 20]
    mov esi, OFFSET array   ; 배열 포인터
    mov ecx, N              ; 개수 N
    mov ebx, -20            ; j (최솟값)
    mov edx, 20             ; k (최댓값)
    call FillArray

    exit
main ENDP

;------------------------------------------------------------
; FillArray
; 전달인자: ESI = 배열 포인터, ECX = 개수(N), EBX = j, EDX = k
; 기능: [j, k] 범위의 난수로 배열을 채움
;------------------------------------------------------------
FillArray PROC
    pushad                  ; 모든 레지스터 보존

    ; 범위 계산: (k - j + 1)
    mov eax, edx
    sub eax, ebx
    inc eax                 ; EAX = range = k - j + 1

L1:
    push eax                ; range 값 보존
    call RandomRange        ; EAX = [0, range - 1]
    add eax, ebx            ; EAX = [0, range - 1] + j = [j, k]
    mov [esi], eax          ; 배열에 저장
    add esi, 4              ; 다음 DWORD 위치로 이동
    pop eax                 ; range 값 복원
    loop L1

    popad                   ; 모든 레지스터 복원
    ret
FillArray ENDP

END main
