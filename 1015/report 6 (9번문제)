9. PIN 유효성 검사 (Validating a PIN)
📌 번역
은행에서는 각 고객을 고유하게 식별하기 위해 개인 식별 번호(PIN)를 사용합니다. 우리 은행은 고객의 5자리 PIN에 있는 각 자릿수에 대해 허용되는 값의 특정 범위를 가지고 있다고 가정해 봅시다. 아래 표에는 허용되는 범위가 포함되어 있으며, 자릿수는 PIN 내에서 왼쪽에서 오른쪽으로 번호가 매겨집니다. 이를 통해 PIN 52413은 유효함을 알 수 있습니다. 하지만 PIN 43534는 첫 번째 자릿수가 범위를 벗어났기 때문에 무효합니다. 마찬가지로 64353은 마지막 자릿수 때문에 무효합니다.

정답:

INCLUDE Irvine32.inc

.data
pin1        BYTE "52413", 0   ; 유효한 PIN 예시
pin2        BYTE "43534", 0   ; 무효한 PIN 예시 (첫째 자리 오류)
pin3        BYTE "64353", 0   ; 무효한 PIN 예시 (마지막 자리 오류)

msgValid    BYTE " -> 유효한 PIN입니다.", 0
msgInvalid  BYTE " -> 무효한 PIN입니다.", 0

; 각 자릿수별 [최솟값, 최댓값] 정의 (인덱스 0~4)
minRanges   BYTE 5, 2, 4, 1, 3
maxRanges   BYTE 9, 5, 8, 4, 6

.code
main PROC
    ; 테스트 1: "52413" 검증
    mov esi, OFFSET pin1
    call ValidatePIN

    ; 테스트 2: "43534" 검증
    mov esi, OFFSET pin2
    call ValidatePIN

    ; 테스트 3: "64353" 검증
    mov esi, OFFSET pin3
    call ValidatePIN

    exit
main ENDP

;------------------------------------------------------------
; ValidatePIN
; 전달인자: ESI = 5자리 PIN 문자열 포인터
;------------------------------------------------------------
ValidatePIN PROC
    pushad

    mov edx, esi
    call WriteString            ; PIN 출력

    mov ecx, 5                  ; 5자리 검사
    mov ebx, 0                  ; 인덱스 0부터 시작

L_CheckDigit:
    mov al, [esi + ebx]         ; 문자 형태의 자릿수 가져오기
    sub al, '0'                 ; ASCII를 정수 값으로 변환

    ; 범위 비교 (minRanges[ebx] <= al <= maxRanges[ebx])
    movzx edx, BYTE PTR [minRanges + ebx]
    cmp al, dl
    jl InalidResult

    movzx edx, BYTE PTR [maxRanges + ebx]
    cmp al, dl
    jg InalidResult

    inc ebx
    loop L_CheckDigit

    ; 모든 자릿수 통과 시 유효
    mov edx, OFFSET msgValid
    call WriteString
    call Crlf
    jmp EndValidate

InalidResult:
    ; 범위 불일치 시 무효
    mov edx, OFFSET msgInvalid
    call WriteString
    call Crlf

EndValidate:
    popad
    ret
ValidatePIN ENDP

END main
