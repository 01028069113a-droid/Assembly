7번 문제: Bitwise Multiplication (비트 연산을 이용한 곱셈)

시프트(shift)와 더하기(addition) 연산만을 사용하여 임의의 부호 없는 32비트 정수와 EAX를 곱하는 BitwiseMultiply 프로시저를 작성하시오. 정수는 EBX 레지스터를 통해 프로시저로 전달하고, 곱한 결과를 EAX 레지스터로 반환하시오. 이 프로시저를 호출하고 결과를 출력하는 짧은 테스트 프로그램을 작성하시오. (결과가 32비트를 초과하지 않는다고 가정합니다.)   이 프로그램은 작성하기 다소 까다로울 수 있습니다. 한 가지 가능한 접근 방식은 승수(multiplier)를 오른쪽으로 시프트하는 루프를 사용하면서, 캐리 플래그(Carry flag)가 설정되기 전까지 발생하는 시프트 횟수를 기록하는 것입니다. 그다음 피승수(multiplicand)를 목적지 피연산자로 사용하여 결과 시프트 횟수를 SHL 명령어에 적용할 수 있습니다. 마지막 1 비트를 승수에서 찾을 때까지 동일한 과정을 반복해야 합니다

정답:

INCLUDE Irvine32.inc

.code
;---------------------------------------------------
; BitwiseMultiply
; 입력: EAX = multiplicand (피승수), EBX = multiplier (승수)
; 반환: EAX = product (결과)
;---------------------------------------------------
BitwiseMultiply PROC
    push ebx
    push ecx
    push edx
    push esi

    mov edx, eax          ; EDX = 피승수 (원래 EAX 값 보존)
    mov esi, 0            ; ESI = 누적합 (결과)

BitLoop:
    cmp ebx, 0
    je Done               ; 승수가 0이 되면 종료

    shr ebx, 1            ; 최하위 비트를 Carry Flag(CF)로 밀어냄
    jnc SkipAdd           ; CF가 0이면 더하지 않고 건너뜀

    add esi, edx          ; CF가 1이면 현재 항(EDX)을 누적합에 더함

SkipAdd:
    shl edx, 1            ; 다음 비트 자릿수에 맞게 피승수를 왼쪽으로 1비트 이동 (* 2)
    jmp BitLoop

Done:
    mov eax, esi          ; 결과를 EAX에 저장
    pop esi
    pop edx
    pop ecx
    pop ebx
    ret
BitwiseMultiply ENDP

main PROC
    ; 테스트: 25 * 10 = 250
    mov eax, 25
    mov ebx, 10
    call BitwiseMultiply
    call WriteDec         ; 250 출력
    call Crlf

    exit
main ENDP
END main
