4번 문제: Encryption Using Rotate Operations (로테이트 연산을 이용한 암호화)

각 평문 바이트를 서로 다른 방향과 횟수로 회전(rotate)하여 간단한 암호화를 수행하는 프로시저를 작성하시오. 예를 들어, 암호화 키를 나타내는 다음 배열에서 음수는 왼쪽 로테이트, 양수는 오른쪽 로테이트를 나타내며, 각 위치의 정수는 로테이트의 크기를 나타냅니다

key BYTE -2, 4, 1, 0, -3, 5, 2, -4, -4, 6

정답:
INCLUDE Irvine32.inc

.code
; EncryptMessage(esi: 메시지 주소, ecx: 메시지 길이, edi: 키 배열 주소, ebx: 키 길이=10)
EncryptMessage PROC
    pushad
    mov edx, 0            ; 키 인덱스 (0~9)

L1:
    mov al, [esi]         ; 평문 바이트 가져오기
    mov cl, [edi + edx]   ; 키 값 가져오기

    cmp cl, 0
    jl RotateLeft
    jgz RotateRight
    jmp NextByte

RotateLeft:
    neg cl                ; 음수를 양수로 변환
    rol al, cl            ; 왼쪽 로테이트
    jmp StoreByte

RotateRight:
    ror al, cl            ; 오른쪽 로테이트

StoreByte:
    mov [esi], al

NextByte:
    inc esi
    inc edx
    cmp edx, 10           ; 키 배열의 끝에 도달했는지 확인
    jne ContinueLoop
    mov edx, 0            ; 키 인덱스 리셋

ContinueLoop:
    dec dword ptr [esp + 16] ; ECX 카운터 감쇠 (pushad 저장값 고려)
    jnz L1

    popad
    ret
EncryptMessage ENDP
```
