6번 문제: Greatest Common Divisor (GCD, 최대공약수)

두 정수의 최대공약수(GCD)는 두 정수를 모두 나누어떨어지게 하는 가장 큰 정수입니다. GCD 알고리즘은 아래의 의사코드(pseudocode)로 설명되는 루프 내 정수 나눗셈을 포함합니다

int GCD(int x, int y)
{
    x = abs(x)       // 절댓값
    y = abs(y)
    do {
        int n = x % y
        x = y
        y = n
    } while (y > 0)
    return x
}

정답:
INCLUDE Irvine32.inc

.code
;---------------------------------------------------
; GCD
; 입력: EAX = x, EBX = y
; 반환: EAX = 최대공약수
;---------------------------------------------------
GCD PROC
    push ebx
    push edx

    ; x = abs(x)
    cmp eax, 0
    jge CheckY
    neg eax

CheckY:
    ; y = abs(y)
    cmp ebx, 0
    jge GCD_Loop
    neg ebx

GCD_Loop:
    ; do { int n = x % y; x = y; y = n; } while (y > 0)
    mov edx, 0
    div ebx               ; EAX / EBX -> 몫: EAX, 나머지(n): EDX

    mov eax, ebx          ; x = y
    mov ebx, edx          ; y = n

    cmp ebx, 0
    jg GCD_Loop           ; while (y > 0)

    pop edx
    pop ebx
    ret
GCD PROC ENDP

main PROC
    ; 테스트 케이스 1: GCD(36, 24) -> 12
    mov eax, 36
    mov ebx, 24
    call GCD
    call WriteDec         ; 12 출력
    call Crlf

    ; 테스트 케이스 2: GCD(-48, 18) -> 6
    mov eax, -48
    mov ebx, 18
    call GCD
    call WriteDec         ; 6 출력
    call Crlf

    exit
main ENDP
END main
