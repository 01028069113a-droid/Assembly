문제:

두개의 숫자를 입력받고 사칙연산 결과와 AX,BX,CX,DX 레지스터의 내용을 화면에 출력하는 프로그램을 작성하시오.

.MODEL SMALL
.STACK 100H

.DATA
    msg1        DB 0DH, 0AH, '첫 번째 숫자: $'
    msg2        DB 0DH, 0AH, '두 번째 숫자: $'

    hdr_add     DB 0DH, 0AH, '[덧셈] '
    lbl_res     DB '결과: $'
    hdr_sub     DB 0DH, 0AH, '[뺄셈] 결과: $'
    hdr_mul     DB 0DH, 0AH, '[곱셈] 결과(DX:AX 16진): $'
    hdr_div_q   DB 0DH, 0AH, '[나눗셈] 몫: $'
    hdr_div_r   DB ', 나머지: $'
    msg_div_err DB 0DH, 0AH, '[나눗셈] 0으로 나눌 수 없습니다.$'

    lbl_ax      DB 0DH, 0AH, '  AX=0x$'
    lbl_bx      DB ' BX=0x$'
    lbl_cx      DB ' CX=0x$'
    lbl_dx      DB ' DX=0x$'

    num1        DW 0
    num2        DW 0
    in_buf      DB 6, 0, 6 DUP(0)

.CODE
MAIN PROC
    MOV AX, @DATA
    MOV DS, AX

    ; 두 숫자 입력
    LEA DX, msg1
    CALL PRINT_STR
    CALL READ_UINT16
    MOV num1, AX

    LEA DX, msg2
    CALL PRINT_STR
    CALL READ_UINT16
    MOV num2, AX

    ; 1. 덧셈 (AX = num1 + num2)
    MOV AX, num1
    MOV BX, num2
    ADD AX, BX

    PUSH AX
    LEA DX, hdr_add
    CALL PRINT_STR
    POP AX
    PUSH AX
    CALL PRINT_UINT16
    POP AX
    CALL PRINT_REGS

    ; 2. 뺄셈 (AX = num1 - num2)
    MOV AX, num1
    MOV BX, num2
    SUB AX, BX

    PUSH AX
    LEA DX, hdr_sub
    CALL PRINT_STR
    POP AX
    PUSH AX
    CALL PRINT_SINT16
    POP AX
    CALL PRINT_REGS

    ; 3. 곱셈 (DX:AX = num1 * num2)
    MOV AX, num1
    MOV BX, num2
    MUL BX

    PUSH DX
    PUSH AX
    LEA DX, hdr_mul
    CALL PRINT_STR
    POP AX
    POP DX
    PUSH DX
    PUSH AX
    CALL PRINT_HEX16       ; 상위 DX 출력
    POP AX
    POP DX
    PUSH DX
    PUSH AX
    CALL PRINT_HEX16       ; 하위 AX 출력 (AX에 DX 값 넣고 호출)
    POP AX
    POP DX
    CALL PRINT_REGS

    ; 4. 나눗셈 (AX = 몫, DX = 나머지)
    MOV BX, num2
    CMP BX, 0
    JE DIV_ZERO

    MOV AX, num1
    XOR DX, DX             ; DX = 0 (DX:AX 32비트 피제수 준비)
    DIV BX

    PUSH DX
    PUSH AX
    LEA DX, hdr_div_q
    CALL PRINT_STR
    POP AX
    PUSH AX
    CALL PRINT_UINT16      ; 몫 출력

    LEA DX, hdr_div_r
    CALL PRINT_STR
    POP AX
    POP DX
    PUSH DX
    PUSH AX
    MOV AX, DX
    CALL PRINT_UINT16      ; 나머지 출력
    POP AX
    POP DX
    CALL PRINT_REGS
    JMP DONE

DIV_ZERO:
    LEA DX, msg_div_err
    CALL PRINT_STR

DONE:
    MOV AH, 4CH
    INT 21H
MAIN ENDP

; --- 문자열 출력 (DX = '$' 종료 문자열 오프셋) ---
PRINT_STR PROC
    PUSH AX
    MOV AH, 09H
    INT 21H
    POP AX
    RET
PRINT_STR ENDP

; --- 10진수 문자열 입력 -> AX ---
READ_UINT16 PROC
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI

    LEA DX, in_buf
    MOV AH, 0AH
    INT 21H

    MOV SI, OFFSET in_buf + 2
    MOV CL, [in_buf + 1]
    XOR CH, CH
    XOR AX, AX
    MOV BX, 10
    JCXZ READ_END

READ_LOOP:
    MOV DL, [SI]
    CMP DL, '0'
    JB READ_NEXT
    CMP DL, '9'
    JA READ_NEXT
    SUB DL, '0'
    XOR DH, DH
    PUSH DX
    MUL BX
    POP DX
    ADD AX, DX
READ_NEXT:
    INC SI
    LOOP READ_LOOP

READ_END:
    POP SI
    POP DX
    POP CX
    POP BX
    RET
READ_UINT16 ENDP

; --- AX 값을 4자리 16진수로 출력 ---
PRINT_HEX16 PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX

    MOV BX, AX
    MOV CX, 4
HEX_L:
    ROL BX, 4
    MOV AL, BL
    AND AL, 0FH
    CMP AL, 9
    JBE H_NUM
    ADD AL, 7
H_NUM:
    ADD AL, '0'
    MOV DL, AL
    MOV AH, 02H
    INT 21H
    LOOP HEX_L

    POP DX
    POP CX
    POP BX
    POP AX
    RET
PRINT_HEX16 ENDP

; --- 현재 AX, BX, CX, DX를 16진수로 출력 ---
PRINT_REGS PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX
    MOV BP, SP             ; [BP+6]=AX, [BP+4]=BX, [BP+2]=CX, [BP+0]=DX

    LEA DX, lbl_ax
    CALL PRINT_STR
    MOV AX, [BP+6]
    CALL PRINT_HEX16

    LEA DX, lbl_bx
    CALL PRINT_STR
    MOV AX, [BP+4]
    CALL PRINT_HEX16

    LEA DX, lbl_cx
    CALL PRINT_STR
    MOV AX, [BP+2]
    CALL PRINT_HEX16

    LEA DX, lbl_dx
    CALL PRINT_STR
    MOV AX, [BP+0]
    CALL PRINT_HEX16

    POP DX
    POP CX
    POP BX
    POP AX
    RET
PRINT_REGS ENDP

; --- AX 부호 없는 10진수 출력 ---
PRINT_UINT16 PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX

    XOR CX, CX
    MOV BX, 10
    CMP AX, 0
    JNE U16_DIV
    MOV DL, '0'
    MOV AH, 02H
    INT 21H
    JMP U16_END

U16_DIV:
    XOR DX, DX
    DIV BX
    PUSH DX
    INC CX
    CMP AX, 0
    JNE U16_DIV

U16_OUT:
    POP DX
    ADD DL, '0'
    MOV AH, 02H
    INT 21H
    LOOP U16_OUT

U16_END:
    POP DX
    POP CX
    POP BX
    POP AX
    RET
PRINT_UINT16 ENDP

; --- AX 부호 있는 10진수 출력 ---
PRINT_SINT16 PROC
    TEST AX, 8000H
    JZ PRINT_UINT16
    PUSH AX
    MOV DL, '-'
    MOV AH, 02H
    INT 21H
    POP AX
    NEG AX
    JMP PRINT_UINT16
PRINT_SINT16 ENDP

END MAIN
