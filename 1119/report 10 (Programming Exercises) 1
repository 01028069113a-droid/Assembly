1번 문제: mReadkey 매크로

번역: 키 입력을 기다린 뒤 눌린 키의 ASCII 코드와 키보드 스캔 코드를 반환하는 매크로를 작성하고 테스트 프로그램을 만드시오

정답: ReadChar 호출 시 AL에 ASCII 코드, AH에 스캔 코드가 들어옵니다.
INCLUDE Irvine32.inc

mReadkey MACRO charCode, scanCode
    push eax
    call ReadChar
    mov charCode, al
    mov scanCode, ah
    pop eax
ENDM

.data
ascii BYTE ?
scan  BYTE ?
msg   BYTE "Press any key...", 0dh, 0ah, 0

.code
main PROC
    mov edx, OFFSET msg
    call WriteString

    mReadkey ascii, scan

    movzx eax, ascii
    call WriteHexB
    call Crlf
    movzx eax, scan
    call WriteHexB
    call Crlf

    exit
main ENDP
END main
