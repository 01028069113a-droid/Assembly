9번문제

번역: SHRD와 SHLD 명령어를 사용하여 32비트 정수 배열을 지정한 비트 수만큼 어느 방향이든 시프트하는 매크로를 만드시오. 
동일한 배열을 양방향으로 시프트하고 결과 값을 출력하여 매크로를 테스트하는 프로그램을 작성하시오. 배열은 리틀 엔디안(little-endian) 순서라고 
가정할 수 있다. 매크로 선언 예시는 다음과 같다:
mShiftDoublewords MACRO arrayName, direction, numberOfBits

정답: 리틀 엔디안 배열에서 상위 워드/더블워드 경계를 넘겨 비트를 이동할 때, 왼쪽 시프트(L)는 하위 요소에서 상위 요소로 비트를 끌어올리므로 SHLD를 
사용하고, 오른쪽 시프트(R)는 상위 요소에서 하위 요소로 비트를 밀어내므로 SHRD를 사용합니다. (CL 레지스터에 시프트 비트 수를 넣습니다.)

INCLUDE Irvine32.inc

mShiftDoublewords MACRO arrayName, direction, numberOfBits
    LOCAL ShiftLeft, ShiftRight, Done, LeftLoop, RightLoop
    pushad
    mov ecx, numberOfBits

    IFIDNI <direction>, <L>
        jmp ShiftLeft
    ELSEIFIDNI <direction>, <R>
        jmp ShiftRight
    ELSE
        ECHO Warning: direction must be L or R.
        jmp Done
    ENDIF

ShiftLeft:
    ; 배열 끝에서 앞으로 순회하며 SHLD로 상위 요소의 하위 비트를 채움
    mov esi, OFFSET arrayName
    mov ebx, LENGTHOF arrayName
    dec ebx
    shl ebx, 2              ; 마지막 요소 바이트 오프셋

LeftLoop:
    cmp ebx, 0
    je ShiftLastLeft
    mov eax, [esi + ebx]
    mov edx, [esi + ebx - 4]
    push ecx
    mov cl, BYTE PTR numberOfBits
    shld eax, edx, cl
    pop ecx
    mov [esi + ebx], eax
    sub ebx, 4
    jmp LeftLoop

ShiftLastLeft:
    mov eax, [esi]
    push ecx
    mov cl, BYTE PTR numberOfBits
    shl eax, cl
    pop ecx
    mov [esi], eax
    jmp Done

ShiftRight:
    ; 배열 앞에서 뒤로 순회하며 SHRD로 하위 요소의 상위 비트를 채움
    mov esi, OFFSET arrayName
    mov ebx, 0
    mov edi, LENGTHOF arrayName
    dec edi
    shl edi, 2              ; 마지막 요소 바이트 오프셋

RightLoop:
    cmp ebx, edi
    jae ShiftLastRight
    mov eax, [esi + ebx]
    mov edx, [esi + ebx + 4]
    push ecx
    mov cl, BYTE PTR numberOfBits
    shrd eax, edx, cl
    pop ecx
    mov [esi + ebx], eax
    add ebx, 4
    jmp RightLoop

ShiftLastRight:
    mov eax, [esi + edi]
    push ecx
    mov cl, BYTE PTR numberOfBits
    shr eax, cl
    pop ecx
    mov [esi + edi], eax

Done:
    popad
ENDM

.data
arr DWORD 11112222h, 33334444h, 55556666h, 77778888h

.code
main PROC
    mShiftDoublewords arr, L, 4
    mov esi, OFFSET arr
    mov ecx, LENGTHOF arr
    mov ebx, TYPE arr
    call DumpMem

    mShiftDoublewords arr, R, 4
    mov esi, OFFSET arr
    mov ecx, LENGTHOF arr
    mov ebx, TYPE arr
    call DumpMem

    exit
main ENDP
END main
