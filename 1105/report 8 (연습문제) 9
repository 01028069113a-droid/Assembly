9. Counting Nearly Matching Elements (거의 일치하는 원소 개수 세기)

★★★ 9. 거의 일치하는 원소 개수 세기
부호 있는 더블워드 배열 두 개를 가리키는 포인터, 두 배열의 길이를 나타내는 매개변수, 
그리고 두 일치하는 원소 간에 허용되는 최대 차이(diff라 부름)를 나타내는 매개변수 등 총 
네 가지 매개변수를 받는 CountNearMatches 프로시저를 작성하세요. 첫 번째 배열의 각 원소 X에 대해, 
두 번째 배열의 대응되는 원소 Yi와의 차이가 diff 이하이면 카운트를 증가시킵니다. 
마지막에 거의 일치하는 배열 원소의 개수를 EAX에 담아 반환하세요. 
CountNearMatches를 호출하고 서로 다른 두 쌍의 배열 포인터를 전달하는 테스트 프로그램을 작성하세요. 
INVOKE 문을 사용하여 프로시저를 호출하고 스택 매개변수를 전달하세요. CountNearMatches에 대한 PROTO 선언을 만드세요. 
프로시저에서 변경된 레지스터들(EAX 제외)은 보존하고 복원하세요. 

정답:  

INCLUDE Irvine32.inc

CountNearMatches PROTO,
    pArr1:PTR SDWORD,
    pArr2:PTR SDWORD,
    arrSize:DWORD,
    maxDiff:DWORD

.data
    arrA SDWORD 10, 20, 30, 40, 50
    arrB SDWORD 12, 25, 28, 41, 60  ; 차이가 (2, 5, 2, 1, 10)
    
    arrC SDWORD 100, 200, 300
    arrD SDWORD 105, 190, 350

.code
main PROC
    ; maxDiff를 5로 설정하고 첫 번째 쌍 테스트 (10/12 차이2 O, 20/25 차이5 O, 30/28 차이2 O, 40/41 차이1 O, 50/60 차이10 X -> 총 4개)
    INVOKE CountNearMatches, ADDR arrA, ADDR arrB, LENGTHOF arrA, 5
    call WriteDec
    call Crlf

    ; maxDiff를 15로 설정하고 두 번째 쌍 테스트
    INVOKE CountNearMatches, ADDR arrC, ADDR arrD, LENGTHOF arrC, 15
    call WriteDec
    call Crlf

    exit
main ENDP

CountNearMatches PROC USES esi edi ecx edx ebx,
    pArr1:PTR SDWORD,
    pArr2:PTR SDWORD,
    arrSize:DWORD,
    maxDiff:DWORD

    mov esi, pArr1
    mov edi, pArr2
    mov ecx, arrSize
    xor edx, edx           ; 카운트 초기화 (EDX = 0)

L_loop:
    mov eax, [esi]
    sub eax, [edi]         ; x_i - y_i 계산
    
    ; 절대값 계산 (EAX = |x_i - y_i|)
    test eax, 80000000h
    jz L_positive
    neg eax
L_positive:

    ; maxDiff와 비교
    mov ebx, maxDiff
    cmp eax, ebx
    jg L_next              ; 차이가 maxDiff보다 크면 스킵
    inc edx                ; 범위 내이면 카운트 증가

L_next:
    add esi, 4
    add edi, 4
    loop L_loop

    mov eax, edx           ; 최종 카운트를 EAX에 반환
    ret
CountNearMatches ENDP

END main
