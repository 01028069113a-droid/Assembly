5. DifferentInputs Procedure (서로 다른 입력값 확인)

5. DifferentInputs 프로시저
세 개의 입력 매개변수 값이 모두 다르면 EAX = 1을 반환하고, 
그렇지 않으면 EAX = 0을 반환하는 DifferentInputs 프로시저를 작성하세요. 
프로시저를 선언할 때 매개변수 리스트와 함께 PROC 지시어를 사용하세요. 
프로시저에 대한 PROTO 선언을 만들고, 서로 다른 입력값을 전달하는 테스트 프로그램에서 이 프로시저를 다섯 번 호출하세요.

정답:
INCLUDE Irvine32.inc

DifferentInputs PROTO,
    val1:SDWORD, val2:SDWORD, val3:SDWORD

.code
main PROC
    ; 1) 모두 다른 경우 (반환: 1)
    INVOKE DifferentInputs, 1, 2, 3   
    call WriteDec
    call Crlf

    ; 2) 일부가 같은 경우 (반환: 0)
    INVOKE DifferentInputs, 1, 2, 1   
    call WriteDec
    call Crlf

    ; 3) 모두 같은 경우 (반환: 0)
    INVOKE DifferentInputs, 5, 5, 5   
    call WriteDec
    call Crlf

    ; 4) 모두 다른 경우 (반환: 1)
    INVOKE DifferentInputs, 10, 20, 30 
    call WriteDec
    call Crlf

    ; 5) 일부가 같은 경우 (반환: 0)
    INVOKE DifferentInputs, 4, 4, 5   
    call WriteDec
    call Crlf

    exit
main ENDP

DifferentInputs PROC,
    val1:SDWORD, val2:SDWORD, val3:SDWORD

    mov eax, val1
    cmp eax, val2
    je L_false
    cmp eax, val3
    je L_false

    mov eax, val2
    cmp eax, val3
    je L_false

    mov eax, 1             ; 모두 다름
    jmp L_end

L_false:
    mov eax, 0             ; 중복 존재

L_end:
    ret
DifferentInputs ENDP

END main
