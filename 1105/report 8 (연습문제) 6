6. Exchanging Integers (정수 교환하기)

6. 정수 교환하기
무작위 순서의 정수 배열을 생성하세요. 교재의 8.4.6절에 나오는 Swap 프로시저를 도구로 사용하여, 
배열 내의 각 연속된 정수 쌍(pair)을 서로 교환하는 루프를 작성하세요.

정답:

INCLUDE Irvine32.inc

Swap PROTO,
    pValX:PTR SDWORD,
    pValY:PTR SDWORD

.data
    arr SDWORD 10, 20, 30, 40, 50, 60
    arrLen = ($ - arr) / 4

.code
main PROC
    mov ecx, arrLen / 2    ; 쌍의 개수만큼 반복
    mov esi, OFFSET arr

L_loop:
    ; 인접한 두 원소의 주소를 전달하여 Swap 호출
    INVOKE Swap, esi, ADDR [esi+4]
    add esi, 8             ; 다음 쌍으로 이동 (2개 원소 = 8바이트 스킵)
    loop L_loop

    ; 결과 출력 확인
    mov ecx, arrLen
    mov esi, OFFSET arr
L_print:
    mov eax, [esi]
    call WriteInt
    call Crlf
    add esi, 4
    loop L_print

    exit
main ENDP

; Swap 프로시저 구현
Swap PROC USES eax ebx esi edi,
    pValX:PTR SDWORD,
    pValY:PTR SDWORD

    mov esi, pValX
    mov edi, pValY
    mov eax, [esi]
    mov ebx, [edi]
    mov [esi], ebx
    mov [edi], eax
    ret
Swap ENDP

END main
