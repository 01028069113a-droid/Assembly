8. Counting Matching Elements (일치하는 원소 개수 세기)

8. 일치하는 원소 개수 세기
부호 있는 더블워드(doubleword) 배열 두 개를 가리키는 포인터와, 
두 배열의 길이를 나타내는 세 번째 매개변수를 받는 CountMatches 프로시저를 작성하세요. 
첫 번째 배열의 각 원소 X에 대해, 두 번째 배열의 대응되는 원소 Yi가 같으면 카운트를 증가시킵니다.
마지막에 일치하는 배열 원소의 개수를 EAX에 담아 반환하세요. 프로시저를 호출하고 
서로 다른 두 쌍의 배열 포인터를 전달하는 테스트 프로그램을 작성하세요. INVOKE 문을 사용하여 프로시저를 호출하고 
스택 매개변수를 전달하세요. CountMatches에 대한 PROTO 선언을 만드세요. 프로시저에서 변경된 레지스터들(EAX 제외)은 보존하고 복원하세요. 

정답:

INCLUDE Irvine32.inc

CountMatches PROTO,
    pArr1:PTR SDWORD,
    pArr2:PTR SDWORD,
    arrSize:DWORD

.data
    arrA SDWORD 1, 2, 3, 4, 5
    arrB SDWORD 1, 9, 3, 0, 5     ; 일치: 1, 3, 5 (총 3개)
    
    arrC SDWORD 10, 20, 30
    arrD SDWORD 10, 20, 99        ; 일치: 10, 20 (총 2개)

.code
main PROC
    ; 첫 번째 쌍 테스트
    INVOKE CountMatches, ADDR arrA, ADDR arrB, LENGTHOF arrA
    call WriteDec
    call Crlf

    ; 두 번째 쌍 테스트
    INVOKE CountMatches, ADDR arrC, ADDR arrD, LENGTHOF arrC
    call WriteDec
    call Crlf

    exit
main ENDP

; CountMatches 프로시저 정의
CountMatches PROC USES esi edi ecx edx,
    pArr1:PTR SDWORD,
    pArr2:PTR SDWORD,
    arrSize:DWORD

    mov esi, pArr1
    mov edi, pArr2
    mov ecx, arrSize
    xor edx, edx           ; 일치 횟수를 저장할 EDX를 0으로 초기화

L_loop:
    mov eax, [esi]
    cmp eax, [edi]
    jne L_next
    inc edx                ; 값이 같으면 카운트 증가

L_next:
    add esi, 4
    add edi, 4
    loop L_loop

    mov eax, edx           ; 최종 일치 개수를 EAX에 반환
    ret
CountMatches ENDP

END main
