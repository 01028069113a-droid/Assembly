4. FindThrees Procedure (숫자 3이 연속으로 나오는 배열 찾기)

4. FindThrees 프로시저
배열 내의 어딘가에 숫자 3이 연속해서 세 번 나오는 경우 1을 반환하고, 
그렇지 않으면 0을 반환하는 FindThrees 프로시저를 작성하세요. 
프로시저의 입력 매개변수 리스트에는 배열을 가리키는 포인터와 배열의 크기가 포함됩니다. 
프로시저를 선언할 때는 매개변수 리스트와 함께 PROC 지시어를 사용하세요. 
프로시저 내부에서 값이 변경되는 레지스터들(EAX 제외)은 모두 보존해야 합니다.
FindThrees를 서로 다른 배열로 여러 번 호출하는 테스트 프로그램을 작성하세요.

정답:
INCLUDE Irvine32.inc

FindThrees PROTO,
    pArray:PTR SDWORD,
    arraySize:DWORD

.data
    arr1 SDWORD 1, 2, 3, 3, 3, 4      ; 연속된 3이 있음 (반환값: 1)
    arr2 SDWORD 3, 3, 1, 2, 3, 3      ; 연속된 3이 없음 (반환값: 0)
    arr3 SDWORD 5, 6, 7, 8            ; 3이 없음 (반환값: 0)

.code
main PROC
    INVOKE FindThrees, ADDR arr1, LENGTHOF arr1
    call WriteDec
    call Crlf

    INVOKE FindThrees, ADDR arr2, LENGTHOF arr2
    call WriteDec
    call Crlf

    INVOKE FindThrees, ADDR arr3, LENGTHOF arr3
    call WriteDec
    call Crlf

    exit
main ENDP

; FindThrees 프로시저 정의
FindThrees PROC USES esi ecx edx,
    pArray:PTR SDWORD,
    arraySize:DWORD

    mov esi, pArray
    mov ecx, arraySize
    sub ecx, 2             ; 3개가 연속해야 하므로 마지막 2개 전까지만 탐감
    jl L_not_found         ; 배열 크기가 3보다 작으면 바로 0 반환

L_loop:
    mov eax, [esi]
    cmp eax, 3
    jne L_continue
    
    ; 두 번째 원소 검사
    mov edx, [esi + 4]
    cmp edx, 3
    jne L_continue

    ; 세 번째 원소 검사
    mov edx, [esi + 8]
    cmp edx, 3
    jne L_continue

    ; 연속된 3 세 개를 찾은 경우
    mov eax, 1
    jmp L_end

L_continue:
    add esi, 4
    loop L_loop

L_not_found:
    mov eax, 0             ; 찾지 못한 경우 0 반환

L_end:
    ret
FindThrees ENDP

END main
