FindLargest Procedure (가장 큰 값 찾기 프로시저)

1. FindLargest 프로시저
부호 있는 더블워드(doubleword, 32비트) 배열을 가리키는 포인터와 배열의 길이를 나타내는 카운트, 
총 두 개의 매개변수를 받는 FindLargest 프로시저를 작성하세요. 
이 프로시저는 배열 원소 중 가장 큰 값을 EAX 레지스터에 담아 반환해야 합니다. 프로시저를 선언할 때는 매개변수 리스트와 함께 PROC 지시어를 사용하세요. 
프로시저 내부에서 값이 변경되는 레지스터들(EAX 제외)은 모두 보존(preserve)해야 합니다. 
FindLargest를 호출하고 길이가 다른 세 가지 서로 다른 배열을 인자로 전달하는 테스트 프로그램을 작성하세요. 
배열에는 반드시 음수 값을 포함시키세요. 또한 FindLargest에 대한 PROTO 선언을 만드세요.

정답:
INCLUDE Irvine32.inc

; PROTO 선언
FindLargest PROTO,
    pArray:PTR SDWORD,    ; 부호 있는 더블워드 배열 포인터
    arraySize:DWORD       ; 배열의 길이

.data
    arr1 SDWORD -5, 12, -3, 42, 7
    arr2 SDWORD -100, -23, -45, -12
    arr3 SDWORD 0, 5, -9, 33, 15, 20

.code
main PROC
    ; 첫 번째 배열 테스트
    INVOKE FindLargest, ADDR arr1, LENGTHOF arr1
    call WriteInt
    call Crlf

    ; 두 번째 배열 테스트
    INVOKE FindLargest, ADDR arr2, LENGTHOF arr2
    call WriteInt
    call Crlf

    ; 세 번째 배열 테스트
    INVOKE FindLargest, ADDR arr3, LENGTHOF arr3
    call WriteInt
    call Crlf

    exit
main ENDP

; FindLargest 프로시저 정의
FindLargest PROC USES esi ecx,
    pArray:PTR SDWORD,
    arraySize:DWORD

    mov esi, pArray        ; 배열 주소를 ESI에 로드
    mov ecx, arraySize     ; 반복 횟수(배열 크기)를 ECX에 로드
    
    mov eax, [esi]         ; 첫 번째 원소를 최댓값(EAX)으로 가정
    sub ecx, 1             ; 첫 번째 원소는 비교했으므로 카운트 1 감소
    jz L2                  ; 원소가 1개뿐이면 바로 종료

L1:
    add esi, 4             ; 다음 더블워드 원소로 이동
    mov edx, [esi]         ; 현재 원소를 EDX에 로드
    cmp edx, eax           ; 현재 최댓값(EAX)과 비교
    jle L2_skip            ; 현재 값이 작거나 같으면 스킵
    mov eax, edx           ; 더 큰 값을 EAX에 갱신

L2_skip:
    loop L1

L2:
    ret                    ; EAX에 최댓값을 담은 채로 반환
FindLargest ENDP

END main
